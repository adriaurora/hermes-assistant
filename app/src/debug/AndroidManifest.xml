<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override: allow cleartext HTTP so the app can reach a
      self-hosted Hermes over a development LAN. Release builds
     keep the platform default (cleartext denied). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
