<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for Hermes Assistant.

  The app enforces HTTPS by default via its own NetworkGate.  This XML
  configuration is ONLY applied to release builds and serves as the
  platform-level fallback boundary.

  In release mode the Android platform denies cleartext traffic by default.
  If a release build needs to reach an approved HTTP endpoint, the
  application must include a matching domain in the <domain-config> section.

  For chat-only builds without FCM, this file is not referenced in the
  manifest and has no effect.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <!-- TLS verification is preserved: no overrides here. -->
    </base-config>
    <!--
      Approved HTTP endpoints for release builds.
      Each <domain> must match the exact origin the user has approved.
      Wildcards are NOT recommended — approval is per-endpoint, not wildcard.

      Example:
      <domain includeSubdomains="false">10.0.0.1</domain>
      <domain includeSubdomains="false">dev.local</domain>

      Production release builds should leave this section empty or remove
      the domain-config entirely.  Debug/release builds targeting specific
      LAN servers must populate it manually.
    -->
</network-security-config>